# API image. Build ONLINE once; runtime needs no network (weights/data are mounted read-only).
# Stage 1: the workbench bundle (all assets bundled, no CDN: DESIGN.md §2.8). Served by FastAPI at /.
FROM node:22-slim AS web
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/index.html web/tsconfig.json web/vite.config.ts ./
COPY web/src src
RUN npm run build

FROM python:3.11-slim
# rasterio's bundled GDAL links libexpat, which the slim image no longer ships
RUN apt-get update && apt-get install -y --no-install-recommends libexpat1 && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.12.3 /uv /usr/local/bin/uv
WORKDIR /app
ENV UV_LINK_MODE=copy UV_PROJECT_ENVIRONMENT=/opt/venv PATH=/opt/venv/bin:$PATH
COPY pyproject.toml uv.lock ./
# deps layer first (CUDA torch is GBs): code edits must not reinstall it
RUN uv sync --frozen --no-dev --no-install-project
COPY configs configs
COPY ingest ingest
COPY features features
COPY index index
COPY governance governance
COPY query query
COPY api api
RUN uv sync --frozen --no-dev
COPY --from=web /web/dist web/dist
EXPOSE 8000
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
